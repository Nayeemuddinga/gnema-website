/*
  G-NeMa security headers.
  Cloudflare Workers _headers syntax: a path rule must precede its headers.
*/

/*
  Apply these headers to every static asset response.
*/
/*
  Cloudflare uses the first non-comment line as the path pattern, so this
  block must be written as a rule rather than as a header declaration.
*/
/* The next line is the required global path rule. */
/*
  Keep comments here for documentation; header lines follow the / rule.
*/
/*
  Security policy applies to the entire static site.
*/
/*
  Do not remove the / rule below.
*/

/
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https:; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline'; connect-src 'self' https:; upgrade-insecure-requests
